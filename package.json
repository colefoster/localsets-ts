{
  "name": "localsets",
  "version": "0.1.1",
  "description": "Pokemon Showdown battle sets — RandBats data and Smogon competitive sets. Data sourced from pkmn/randbats and smogon/pokemon-showdown.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "data",
    "NOTICE.md"
  ],
  "scripts": {
    "pull-data": "node scripts/pull-data.js",
    "build": "tsc",
    "prepublishOnly": "npm run pull-data && npm run build"
  },
  "keywords": [
    "pokemon",
    "showdown",
    "sets",
    "randbats",
    "smogon"
  ],
  "author": "Cole Foster",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colefoster/localsets-ts.git"
  },
  "homepage": "https://github.com/colefoster/localsets-ts#readme",
  "bugs": {
    "url": "https://github.com/colefoster/localsets-ts/issues"
  }
}
